# ---- LLM ----------------------------------------------------------------
# mock       - offline, детерминированная заглушка (профиль local)
# openrouter - внешний OpenAI-совместимый провайдер
LLM_PROVIDER=mock
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o-mini
# Запасная модель, если основную лимитирует её upstream-провайдер (429). Пусто — без запасной.
LLM_FALLBACK_MODEL=

# ---- Интеграция «ПЛАН РАЗВИТИЯ» -> «Компас» ------------------------------
# Общий HMAC-секрет для подписи токена входа. Минимум 32 символа.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
KOMPAS_FRONTEND_URL=http://localhost:4200

# ---- Spring -------------------------------------------------------------
# local - офлайн (MockLlmClient), prod - внешний LLM
SPRING_PROFILES_ACTIVE=local

# Куда «Компас» возвращает готовый план (форма старого сервиса)
LEGACY_IMPORT_URL=http://localhost:8081/import

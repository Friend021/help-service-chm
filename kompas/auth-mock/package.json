{
  "name": "compass-mock-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Mock backend for the Compass (IDP) Angular SPA: REST + SSE + mock Keycloak",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/formbody": "^8.0.2",
    "fastify": "^5.2.1",
    "jose": "^6.0.10",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.9.2",
    "vitest": "^3.0.9",
    "yaml": "^2.9.1"
  }
}

# HTTP
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Публичный адрес мока. Используется в issuer и во всех ссылках Keycloak.
PUBLIC_URL=http://localhost:3000

# Mock Keycloak
REALM=compass
CLIENT_ID=compass-frontend
CLIENT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=300
REFRESH_TOKEN_TTL_SECONDS=1800
# Origin'ы, на которые разрешён redirect_uri в authorization code flow
ALLOWED_REDIRECT_ORIGINS=http://localhost:4200

# CORS для SPA
CORS_ORIGINS=http://localhost:4200

# Куда «План развития» вернёт пользователя после экспорта
LEGACY_RETURN_URL=https://re-team.internal/assessment/development-plan?imported=true

# Эмуляция задержек LLM. Для тестов/CI поставьте 0.
INITIAL_DELAY_MS=400
STREAM_DELAY_MS=35
STREAM_CHUNK_WORDS=3

# false — отключить проверку Bearer (только для отладки)
REQUIRE_AUTH=true

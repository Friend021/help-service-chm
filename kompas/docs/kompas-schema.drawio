        <mxCell id="I" value="Экспорт DOCX / JSON" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1F3;strokeColor=#1F6E80;fontColor=#0F3B43;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="900" width="200" height="56" as="geometry" />

        <mxCell id="H" value="Что делаем с готовым планом?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#E6F1F3;strokeColor=#1F6E80;fontColor=#0F3B43;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="250" y="744" width="200" height="90" as="geometry" />

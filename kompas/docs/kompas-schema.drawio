        <mxCell id="fSZ" value="код не из справочника → отброшен" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#C2851A;fontColor=#C2851A;fontSize=11;" edge="1" parent="1" source="S" target="Z"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="eHK" value="возврат в форму" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#5B6B70;fontColor=#5B6B70;fontSize=11;" edge="1" parent="1" source="H" target="K"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eKA" value="круг замыкается" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#D8141F;fontColor=#D8141F;fontSize=11;exitX=1;exitY=0;entryX=1;entryY=0.5;" edge="1" parent="1" source="K" target="A"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="J" value="Отправить на согласование: статус ON_APPROVAL + уведомление руководителю" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1F3;strokeColor=#1F6E80;fontColor=#0F3B43;fontSize=13;" vertex="1" parent="1">

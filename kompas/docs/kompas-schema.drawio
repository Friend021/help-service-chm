        <mxCell id="eTG" value="срез пути для демо" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#5B6B70;fontColor=#5B6B70;fontSize=11;" edge="1" parent="1" source="T" target="G"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="eHI" value="экспорт" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#5B6B70;fontColor=#5B6B70;fontSize=11;" edge="1" parent="1" source="H" target="I"><mxGeometry relative="1" as="geometry" /></mxCell>

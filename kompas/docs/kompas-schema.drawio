<mxfile host="app.diagrams.net" type="device">
  <diagram id="flow-main" name="Сквозной путь">
    <mxGraphModel dx="900" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="A" value="Сотрудник открывает форму «ПЛАН РАЗВИТИЯ»" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#EEF0F2;strokeColor=#8A9499;fontColor=#26313A;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="220" y="40" width="260" height="54" as="geometry" />
        </mxCell>
        <mxCell id="B" value="Нажимает «Сформировать с помощью Компаса»" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#D8141F;fontColor=#7A0A0F;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="220" y="134" width="260" height="56" as="geometry" />
        </mxCell>
        <mxCell id="C" value="Заглушка выдаёт подписанный токен с контекстом сотрудника и делает redirect" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#D8141F;fontColor=#7A0A0F;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="220" y="230" width="260" height="64" as="geometry" />
        </mxCell>
        <mxCell id="D" value="SPA меняет короткий токен входа на рабочий токен доступа (POST /api/sessions)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1F3;strokeColor=#1F6E80;fontColor=#0F3B43;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="220" y="334" width="260" height="64" as="geometry" />
        </mxCell>
        <mxCell id="E" value="Backend создаёт сессию и делает первый ход ассистента" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1F3;strokeColor=#1F6E80;fontColor=#0F3B43;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="220" y="438" width="260" height="56" as="geometry" />
        </mxCell>
        <mxCell id="F" value="Диалог: шесть стадий&#10;CONTEXT → GAP_ANALYSIS → INTERESTS → DRAFT → REFINE → FINALIZE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1F3;strokeColor=#1F6E80;fontColor=#0F3B43;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="220" y="534" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="G" value="Живой черновик ИПР в панели справа, правится вручную" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1F3;strokeColor=#1F6E80;fontColor=#0F3B43;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="220" y="644" width="260" height="56" as="geometry" />
        </mxCell>

        <mxCell id="T" value="Кнопка «Сгенерировать тестовый ИПР» — болванка без обращения к LLM" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#E6F1F3;strokeColor=#1F6E80;fontColor=#0F3B43;fontSize=12;" vertex="1" parent="1">

  <diagram id="flow-turn" name="Один ход диалога">
    <mxGraphModel dx="900" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="M" value="Сообщение сотрудника" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#EEF0F2;strokeColor=#8A9499;fontColor=#26313A;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="300" y="40" width="260" height="54" as="geometry" />
        </mxCell>
        <mxCell id="R" value="Retriever собирает контекст: компетенции целевой роли, каталог активностей, рубрики и инструменты формы" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E2;strokeColor=#C2851A;fontColor=#6B4708;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="280" y="134" width="300" height="78" as="geometry" />
        </mxCell>
        <mxCell id="P" value="PromptBuilder: системный промпт + стадия + состояние сессии + контекст + история" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1F3;strokeColor=#1F6E80;fontColor=#0F3B43;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="280" y="252" width="300" height="72" as="geometry" />
        </mxCell>
        <mxCell id="L" value="Внешняя LLM — один ответ строго в JSON" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFE9F7;strokeColor=#6D5BA6;fontColor=#3B2F63;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="300" y="364" width="260" height="56" as="geometry" />
        </mxCell>
        <mxCell id="S" value="DraftParser разбирает ответ и вычищает коды, которых нет в справочниках" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1F3;strokeColor=#1F6E80;fontColor=#0F3B43;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="280" y="460" width="300" height="64" as="geometry" />
        </mxCell>
        <mxCell id="U" value="IdpService обновляет черновик ИПР" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1F3;strokeColor=#1F6E80;fontColor=#0F3B43;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="300" y="564" width="260" height="54" as="geometry" />
        </mxCell>
        <mxCell id="N" value="Стадия двигается дальше (переход решает код, не модель)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1F3;strokeColor=#1F6E80;fontColor=#0F3B43;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="290" y="658" width="280" height="56" as="geometry" />
        </mxCell>

        <mxCell id="Z" value="Заземление: ассистент не может выдумать компетенцию или курс вне каталога" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFF4E2;strokeColor=#C2851A;fontColor=#6B4708;fontSize=12;" vertex="1" parent="1">
